# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nse_market_data
DB_USER=postgres
DB_PASSWORD=your_password_here

# Alternative: single connection string URI
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/nse_market_data

# Downloader Configuration
DOWNLOAD_DIR=./downloads
REQUEST_TIMEOUT=30
RETRY_COUNT=3
RETRY_DELAY=2

# Insider & Deal Data Pipeline - Exchange Configuration
# Comma-separated list of exchanges the pipeline extracts/processes deals
# for (see scripts/common/__init__.py:ENABLED_EXCHANGES/EXCHANGE_API_CODES).
# MUST remain NSE-only in production: the market-price/EOD dataset
# (nse_equity_eod) currently contains NSE data only, so deals from any
# other exchange could never be correlated with price data anyway.
# Future example (do not enable until BSE EOD data + a verified StockEdge
# API code exist): ENABLED_EXCHANGES=NSE,BSE
ENABLED_EXCHANGES=NSE

# Exchange(s) preselected in the System Health pipeline UI / used when a
# pipeline run doesn't explicitly select any. Comma-separated; must be a
# subset of ENABLED_EXCHANGES above. DEFAULT_EXCHANGE (singular) is also
# accepted for backward compatibility and is treated the same way.
DEFAULT_EXCHANGES=NSE
